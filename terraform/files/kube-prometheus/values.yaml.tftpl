alertmanager:
  enabled: false

# helm upgrade does not update CRDs. This job applies the CRDs of the chart version before install and upgrade.
crds:
  upgradeJob:
    enabled: true

defaultRules:
  create: false

prometheus:
  prometheusSpec:
    enableAdminAPI: false
    retention: 30d
    retentionSize: 450GB
    resources:
      requests:
        memory: ${prometheus_memory_request}
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    probeSelectorNilUsesHelmValues: false
    scrapeConfigSelectorNilUsesHelmValues: false
    remoteWriteDashboards: true
    persistentVolumeClaimRetentionPolicy:
      whenDeleted: Delete
    storageSpec:
      volumeClaimTemplate:
        metadata:
          name: prometheus
        spec:
          storageClassName: oci-bv
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 500Gi
%{ if gpu_health_monitoring }
  # The GPU Health Monitoring add-on has no Service or monitor. Scrape the scan metrics of its fault monitor.
  additionalPodMonitors:
    - name: gpu-fault-monitor
      namespaceSelector:
        matchNames:
          - gpu-health-monitoring
      selector:
        matchLabels:
          app: gpu-fault-monitor
      podMetricsEndpoints:
        - port: http
          scheme: https
          tlsConfig:
            insecureSkipVerify: true
          relabelings:
            - sourceLabels: [__meta_kubernetes_pod_node_name]
              targetLabel: hostname
%{ endif }

prometheus-node-exporter:
  # The chart default rolls one node at a time, which takes longer than helm --wait on large clusters.
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 25%
  prometheus:
    monitor:
      relabelings:
        - sourceLabels: [__meta_kubernetes_node_label_node_kubernetes_io_instance_type]
          targetLabel: instance_shape
        - sourceLabels: [__meta_kubernetes_node_label_oci_oraclecloud_com_host_serial_number]
          targetLabel: host_serial_number
        - sourceLabels: [__meta_kubernetes_node_label_displayName]
          targetLabel: oci_name
        - sourceLabels: [__meta_kubernetes_pod_node_name]
          targetLabel: hostname
          action: replace
      attachMetadata:
        node: true
      # No dashboard or rule uses guest CPU time; it adds 2 series per CPU thread.
      metricRelabelings:
        - sourceLabels: [__name__]
          regex: node_cpu_guest_seconds_total
          action: drop
        # Dashboards read only idle CPU time. Keep user, system and iowait for debugging.
        - sourceLabels: [__name__, mode]
          regex: node_cpu_seconds_total;(irq|nice|softirq|steal)
          action: drop
  extraArgs:
    # Unused collectors with high per-node series counts on large GPU hosts.
    - --no-collector.ipvs
    - --no-collector.cpufreq
    - --no-collector.thermal_zone
    - --no-collector.softnet
    - --no-collector.schedstat
    - --no-collector.hwmon
    - --collector.mountstats
    - --collector.textfile.directory=/host/root/var/lib/node_exporter/textfile_collector
    - --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|var/lib/docker/.+|var/lib/kubelet/.+)($|/)
    - --collector.filesystem.fs-types-exclude=^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$

grafana:
  enabled: ${install_grafana}
  defaultDashboardsEnabled: false
  persistence:
    enabled: true
    type: sts
    storageClassName: "oci-bv"
    accessModes:
      - ReadWriteOnce
    size: 100Gi
    persistentVolumeClaimRetentionPolicy:
      whenDeleted: Delete
    finalizers:
      - kubernetes.io/pvc-protection
  sidecar:
    alerts:
      enabled: ${setup_alerting}
    dashboards:
      enabled: true
      folderAnnotation: grafana_dashboard_folder
      provider:
        allowUiUpdates: true
        disableDelete: false
        foldersFromFilesStructure: true

%{ if preferred_kubernetes_services == "public" }
  grafana.ini:
    server:
      root_url: "%(protocol)s://%(domain)s"
%{ endif }

kubelet:
  serviceMonitor:
    attachMetadata:
      node: true
    # The chart scrapes cAdvisor every 10s, but cAdvisor refreshes its stats only
    # every ~15s and the samples carry cAdvisor's timestamps, so about a third of
    # every scrape repeats the previous sample and is dropped. Grafana never
    # steps below the datasource's 30s timeInterval, so 30s, the stack-wide
    # interval, changes no dashboard.
    cAdvisorInterval: 30s
    # No dashboard or rule reads the probe metrics.
    probes: false
    # Helm replaces lists, so the drop lists below repeat the chart 92.0.0 defaults first.
    metricRelabelings:
      - action: drop
        sourceLabels: [__name__, le]
        regex: (csi_operations|storage_operation_duration)_seconds_bucket;(0.25|2.5|15|25|120|600)(\.0)?
      # One series per feature gate per node. No dashboard or rule reads it.
      - action: drop
        sourceLabels: [__name__]
        regex: kubernetes_feature_enabled
    cAdvisorMetricRelabelings:
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_cpu_(cfs_throttled_seconds_total|load_average_10s|system_seconds_total|user_seconds_total)'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_fs_(io_current|io_time_seconds_total|io_time_weighted_seconds_total|reads_merged_total|sector_reads_total|sector_writes_total|writes_merged_total)'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_memory_(mapped_file|swap)'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_(file_descriptors|tasks_state|threads_max)'
      - sourceLabels: [__name__, scope]
        action: drop
        regex: 'container_memory_failures_total;hierarchy'
      - sourceLabels: [__name__, interface]
        action: drop
        regex: 'container_network_.*;(cali|cilium|cni|lxc|nodelocaldns|tunl).*'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_spec.*'
      - sourceLabels: [id, pod]
        action: drop
        regex: '.+;'
      # cAdvisor metrics that no dashboard or rule reads. Memory usage, OOM events and
      # CPU throttling stay for debugging.
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_blkio_device_usage_total|container_network_(receive|transmit)_errors_total|container_pressure_.*'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_memory_(failures_total|failcnt|kernel_usage|max_usage_bytes|total_active_file_bytes|total_inactive_file_bytes)'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_(health_state|last_seen|processes|scrape_error|sockets|start_time_seconds|threads|ulimits_soft)'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_cpu_(cfs_burst_periods_total|cfs_burst_seconds_total|load_d_average_10s)'
      - sourceLabels: [__name__]
        action: drop
        regex: 'container_fs_(inodes_free|inodes_total|limit_bytes|read_seconds_total|usage_bytes|write_seconds_total)'

# No dashboard or rule reads the kube-proxy metrics.
kubeProxy:
  enabled: false

kube-state-metrics:
  serviceAccount:
    create: true
  # Per-pod metadata series that no dashboard or rule reads.
  metricDenylist:
    - kube_pod_tolerations
    - kube_pod_ips
    - kube_pod_status_qos_class
    - kube_pod_service_account
    - kube_pod_scheduler
    - kube_pod_restart_policy
%{ if gpu_health_monitoring }
  metricLabelsAllowlist:
    - nodes=[node.kubernetes.io/instance-type,oci.oraclecloud.com/node.info.managed]
  # Export the GPU Health Monitoring add-on NodeHealthReports (faults and repairs) as metrics.
  rbac:
    extraRules:
      - apiGroups: ["oci.oraclecloud.com"]
        resources: ["nodehealthreports"]
        verbs: ["list", "watch"]
  customResourceState:
    enabled: true
    config:
      kind: CustomResourceStateMetrics
      spec:
        resources:
          - groupVersionKind:
              group: oci.oraclecloud.com
              version: v1beta1
              kind: NodeHealthReport
            metricNamePrefix: oke_node_health_report
            labelsFromPath:
              node: [spec, nodeRef, name]
              report_uid: [metadata, uid]
            metrics:
              - name: repair_info
                help: Current repair of the node.
                each:
                  type: Info
                  info:
                    labelsFromPath:
                      action: [status, repair, repairAction]
                      phase: [status, repair, execution, repairPhase]
                      terminal_state: [status, repair, terminalState]
                      dry_run: [status, repair, dryRun]
                      admission: [status, repair, admission, state]
              - name: repair_started_timestamp_seconds
                help: Start time of the current repair (0 when there is none).
                each:
                  type: Gauge
                  gauge:
                    path: [status, repair, startedAt]
                    nilIsZero: true
              - name: last_repair_info
                help: Last repair attempt of the node.
                each:
                  type: Info
                  info:
                    labelsFromPath:
                      action: [status, lastRepairAttempt, repairAction]
                      result: [status, lastRepairAttempt, result]
                      dry_run: [status, lastRepairAttempt, dryRun]
              # A gauge path that points to an object reads every field of it, so point at the field itself.
              - name: last_repair_completed_timestamp_seconds
                help: Completion time of the last repair attempt (0 when there is none).
                each:
                  type: Gauge
                  gauge:
                    path: [status, lastRepairAttempt, completedAt]
                    nilIsZero: true
              - name: signal_first_observed_timestamp_seconds
                help: First time a fault signal was seen.
                commonLabels:
                  source: clusterHealthCheck
                each:
                  type: Gauge
                  gauge:
                    path: [status, signals, clusterHealthCheck]
                    nilIsZero: true
                    valueFrom: [firstObservedAt]
                    labelsFromPath:
                      signal_id: [id]
                      fault_code: [faultCode]
                      action: [action]
                      description: [faultDescription]
              - name: signal_last_observed_timestamp_seconds
                help: Last time a fault signal was seen.
                commonLabels:
                  source: clusterHealthCheck
                each:
                  type: Gauge
                  gauge:
                    path: [status, signals, clusterHealthCheck]
                    nilIsZero: true
                    valueFrom: [lastObservedAt]
                    labelsFromPath:
                      signal_id: [id]
                      fault_code: [faultCode]
                      action: [action]
                      description: [faultDescription]
              - name: signal_first_observed_timestamp_seconds
                help: First time a fault signal was seen.
                commonLabels:
                  source: customer
                each:
                  type: Gauge
                  gauge:
                    path: [status, signals, customer]
                    nilIsZero: true
                    valueFrom: [firstObservedAt]
                    labelsFromPath:
                      signal_id: [id]
                      fault_code: [faultCode]
                      action: [action]
                      description: [faultDescription]
              - name: signal_last_observed_timestamp_seconds
                help: Last time a fault signal was seen.
                commonLabels:
                  source: customer
                each:
                  type: Gauge
                  gauge:
                    path: [status, signals, customer]
                    nilIsZero: true
                    valueFrom: [lastObservedAt]
                    labelsFromPath:
                      signal_id: [id]
                      fault_code: [faultCode]
                      action: [action]
                      description: [faultDescription]
              - name: signal_first_observed_timestamp_seconds
                help: First time a fault signal was seen.
                commonLabels:
                  source: hpcFault
                each:
                  type: Gauge
                  gauge:
                    path: [status, signals, hpcFault]
                    nilIsZero: true
                    valueFrom: [firstObservedAt]
                    labelsFromPath:
                      signal_id: [id]
                      fault_code: [faultCode]
              - name: signal_last_observed_timestamp_seconds
                help: Last time a fault signal was seen.
                commonLabels:
                  source: hpcFault
                each:
                  type: Gauge
                  gauge:
                    path: [status, signals, hpcFault]
                    nilIsZero: true
                    valueFrom: [lastObservedAt]
                    labelsFromPath:
                      signal_id: [id]
                      fault_code: [faultCode]
              - name: maintenance_event_last_observed_timestamp_seconds
                help: Last time a maintenance event signal was seen.
                each:
                  type: Gauge
                  gauge:
                    path: [status, signals, maintenanceEvent]
                    nilIsZero: true
                    valueFrom: [lastObservedAt]
                    labelsFromPath:
                      action: [action]
                      maintenance_state: [maintenanceLifecycleState]
                      maintenance_event_id: [maintenanceEventId]
%{ endif }

additionalPrometheusRulesMap:
%{ if gpu_health_monitoring }
  gpu-repair-history:
    groups:
      - name: gpu-repair-history
        interval: 30s
        rules:
          # Capture the result with its timestamp before the report changes or disappears.
          - record: oke_node_health_report_repair_completion_timestamp_seconds
            expr: |
              oke_node_health_report_last_repair_completed_timestamp_seconds
              * ignoring(action, result, dry_run) group_left(action, result, dry_run)
              oke_node_health_report_last_repair_info
%{ endif }
  kube-apiserver-availability-rules:
    groups:
      - name: kube-apiserver-availability.rules
        interval: 3m
        rules:
          - record: code_verb:apiserver_request_total:increase1h
            expr: sum by (cluster, code, verb) (increase(apiserver_request_total{job="apiserver",verb=~"LIST|GET|POST|PUT|PATCH|DELETE",code=~"2.."}[1h]))
          - record: code_verb:apiserver_request_total:increase1h
            expr: sum by (cluster, code, verb) (increase(apiserver_request_total{job="apiserver",verb=~"LIST|GET|POST|PUT|PATCH|DELETE",code=~"3.."}[1h]))
          - record: code_verb:apiserver_request_total:increase1h
            expr: sum by (cluster, code, verb) (increase(apiserver_request_total{job="apiserver",verb=~"LIST|GET|POST|PUT|PATCH|DELETE",code=~"4.."}[1h]))
          - record: code_verb:apiserver_request_total:increase1h
            expr: sum by (cluster, code, verb) (increase(apiserver_request_total{job="apiserver",verb=~"LIST|GET|POST|PUT|PATCH|DELETE",code=~"5.."}[1h]))
          - record: code_verb:apiserver_request_total:increase30d
            expr: avg_over_time(code_verb:apiserver_request_total:increase1h[30d]) * 24 * 30
          - record: code:apiserver_request_total:increase30d
            labels:
              verb: read
            expr: sum by (cluster, code) (code_verb:apiserver_request_total:increase30d{verb=~"LIST|GET"})
          - record: code:apiserver_request_total:increase30d
            labels:
              verb: write
            expr: sum by (cluster, code) (code_verb:apiserver_request_total:increase30d{verb=~"POST|PUT|PATCH|DELETE"})
          - record: cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase1h
            expr: sum by (cluster, verb, scope, le) (increase(apiserver_request_sli_duration_seconds_bucket[1h]))
          - record: cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase30d
            expr: sum by (cluster, verb, scope, le) (avg_over_time(cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase1h[30d]) * 24 * 30)
          - record: cluster_verb_scope:apiserver_request_sli_duration_seconds_count:increase1h
            expr: sum by (cluster, verb, scope) (cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase1h{le="+Inf"})
          - record: cluster_verb_scope:apiserver_request_sli_duration_seconds_count:increase30d
            expr: sum by (cluster, verb, scope) (cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase30d{le="+Inf"})
          - record: apiserver_request:availability30d
            labels:
              verb: all
            expr: |
              1 - (
                (
                  (
                    sum by (cluster) (cluster_verb_scope:apiserver_request_sli_duration_seconds_count:increase30d{verb=~"POST|PUT|PATCH|DELETE"})
                    -
                    sum by (cluster) (cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase30d{verb=~"POST|PUT|PATCH|DELETE",le=~"1(\\.0)?"} or vector(0))
                  )
                  +
                  (
                    sum by (cluster) (cluster_verb_scope:apiserver_request_sli_duration_seconds_count:increase30d{verb=~"LIST|GET"})
                    -
                    (
                      sum by (cluster) (cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase30d{verb=~"LIST|GET",scope=~"resource|",le=~"1(\\.0)?"} or vector(0))
                      +
                      sum by (cluster) (cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase30d{verb=~"LIST|GET",scope="namespace",le=~"5(\\.0)?"} or vector(0))
                      +
                      sum by (cluster) (cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase30d{verb=~"LIST|GET",scope="cluster",le=~"30(\\.0)?"} or vector(0))
                    )
                  )
                  +
                  sum by (cluster) (code:apiserver_request_total:increase30d{code=~"5.."} or vector(0))
                )
                /
                sum by (cluster) (code:apiserver_request_total:increase30d)
              )
          - record: apiserver_request:availability30d
            labels:
              verb: read
            expr: |
              1 - (
                (
                  sum by (cluster) (cluster_verb_scope:apiserver_request_sli_duration_seconds_count:increase30d{verb=~"LIST|GET"})
                  -
                  (
                    sum by (cluster) (cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase30d{verb=~"LIST|GET",scope=~"resource|",le=~"1(\\.0)?"} or vector(0))
                    +
                    sum by (cluster) (cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase30d{verb=~"LIST|GET",scope="namespace",le=~"5(\\.0)?"} or vector(0))
                    +
                    sum by (cluster) (cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase30d{verb=~"LIST|GET",scope="cluster",le=~"30(\\.0)?"} or vector(0))
                  )
                  +
                  sum by (cluster) (code:apiserver_request_total:increase30d{verb="read",code=~"5.."} or vector(0))
                )
                /
                sum by (cluster) (code:apiserver_request_total:increase30d{verb="read"})
              )
          - record: apiserver_request:availability30d
            labels:
              verb: write
            expr: |
              1 - (
                (
                  (
                    sum by (cluster) (cluster_verb_scope:apiserver_request_sli_duration_seconds_count:increase30d{verb=~"POST|PUT|PATCH|DELETE"})
                    -
                    sum by (cluster) (cluster_verb_scope_le:apiserver_request_sli_duration_seconds_bucket:increase30d{verb=~"POST|PUT|PATCH|DELETE",le=~"1(\\.0)?"} or vector(0))
                  )
                  +
                  sum by (cluster) (code:apiserver_request_total:increase30d{verb="write",code=~"5.."} or vector(0))
                )
                /
                sum by (cluster) (code:apiserver_request_total:increase30d{verb="write"})
              )
          - record: code_resource:apiserver_request_total:rate5m
            labels:
              verb: read
            expr: sum by (cluster,code,resource) (rate(apiserver_request_total{job="apiserver",verb=~"LIST|GET"}[5m]))
          - record: code_resource:apiserver_request_total:rate5m
            labels:
              verb: write
            expr: sum by (cluster,code,resource) (rate(apiserver_request_total{job="apiserver",verb=~"POST|PUT|PATCH|DELETE"}[5m]))
      - name: kube-apiserver-slos
        rules:
          - record: cluster_quantile:apiserver_request_sli_duration_seconds:histogram_quantile
            labels:
              quantile: "0.99"
              verb: read
            expr: histogram_quantile(0.99, sum by (cluster, le, resource) (rate(apiserver_request_sli_duration_seconds_bucket{job="apiserver",verb=~"LIST|GET",subresource!~"proxy|attach|log|exec|portforward"}[5m]))) > 0
          - record: cluster_quantile:apiserver_request_sli_duration_seconds:histogram_quantile
            labels:
              quantile: "0.99"
              verb: write
            expr: histogram_quantile(0.99, sum by (cluster, le, resource) (rate(apiserver_request_sli_duration_seconds_bucket{job="apiserver",verb=~"POST|PUT|PATCH|DELETE",subresource!~"proxy|attach|log|exec|portforward"}[5m]))) > 0
  k8s-container-resource-rules:
    groups:
      - name: k8s.rules.container_cpu_usage_seconds_total
        rules:
          - record: node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate
            expr: |
              sum by (cluster, namespace, pod, container) (
                irate(container_cpu_usage_seconds_total{job="kubelet", metrics_path="/metrics/cadvisor", image!=""}[5m])
              ) * on (cluster, namespace, pod) group_left(node) topk by (cluster, namespace, pod) (
                1, max by(cluster, namespace, pod, node) (kube_pod_info{node!=""})
              )
      - name: k8s.rules.container_resource
        rules:
          - record: cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests
            expr: |
              kube_pod_container_resource_requests{resource="cpu",job="kube-state-metrics"} * on (namespace, pod, cluster)
              group_left() max by (namespace, pod, cluster) (
                (kube_pod_status_phase{phase=~"Pending|Running"} == 1)
              )
          - record: cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits
            expr: |
              kube_pod_container_resource_limits{resource="cpu",job="kube-state-metrics"} * on (namespace, pod, cluster)
              group_left() max by (namespace, pod, cluster) (
                (kube_pod_status_phase{phase=~"Pending|Running"} == 1)
              )
          - record: cluster:namespace:pod_memory:active:kube_pod_container_resource_requests
            expr: |
              kube_pod_container_resource_requests{resource="memory",job="kube-state-metrics"} * on (namespace, pod, cluster)
              group_left() max by (namespace, pod, cluster) (
                (kube_pod_status_phase{phase=~"Pending|Running"} == 1)
              )
          - record: cluster:namespace:pod_memory:active:kube_pod_container_resource_limits
            expr: |
              kube_pod_container_resource_limits{resource="memory",job="kube-state-metrics"} * on (namespace, pod, cluster)
              group_left() max by (namespace, pod, cluster) (
                (kube_pod_status_phase{phase=~"Pending|Running"} == 1)
              )
  node-health-rules:
    groups:
      - name: node_health
        rules:
%{ if !npd_removed }
          # The NPD condition lists and counts come from Terraform. NPD is removed only with gpu_health_monitoring_remove_npd=true and full add-on coverage.
          - record: node_npd_failed
            expr: |
              max by(hostname) (
                label_replace(
                  (
                    (
                      max by(node) (
                        (kube_node_status_condition{condition=~"${npd_amd_conditions}",status="true"} == bool 1)
                        and on(node)
                        (kube_node_status_capacity{resource="amd_com_gpu"} > 0)
                      )
                      or
                      (0 * max by(node) (kube_node_status_capacity{resource="amd_com_gpu"} > 0))
                    )
                    or
                    (
                      max by(node) (
                        (kube_node_status_condition{condition=~"${npd_nvidia_conditions}",status="true"} == bool 1)
                        and on(node)
                        (kube_node_status_capacity{resource="nvidia_com_gpu"} > 0)
                      )
                      or
                      (0 * max by(node) (kube_node_status_capacity{resource="nvidia_com_gpu"} > 0))
                    )
                  ),
                  "hostname", "$1", "node", "(.*)"
                )
              )
          - record: node_npd_unknown_condition
            expr: |
              max by(hostname) (
                label_replace(
                  (
                    (
                      max by(node) (
                        (kube_node_status_condition{condition=~"${npd_amd_conditions}",status="unknown"} == bool 1)
                        and on(node)
                        (kube_node_status_capacity{resource="amd_com_gpu"} > 0)
                      )
                      or
                      (0 * max by(node) (kube_node_status_capacity{resource="amd_com_gpu"} > 0))
                    )
                    or
                    (
                      max by(node) (
                        (kube_node_status_condition{condition=~"${npd_nvidia_conditions}",status="unknown"} == bool 1)
                        and on(node)
                        (kube_node_status_capacity{resource="nvidia_com_gpu"} > 0)
                      )
                      or
                      (0 * max by(node) (kube_node_status_capacity{resource="nvidia_com_gpu"} > 0))
                    )
                  ),
                  "hostname", "$1", "node", "(.*)"
                )
              )
          - record: node_npd_condition_count
            expr: |
              max by(hostname) (
                label_replace(
                  (
                    (
                      count by(node) (
                        max by(node, condition) (
                          kube_node_status_condition{condition=~"${npd_amd_conditions}"}
                          and on(node)
                          (kube_node_status_capacity{resource="amd_com_gpu"} > 0)
                        )
                      )
                      or
                      (0 * max by(node) (kube_node_status_capacity{resource="amd_com_gpu"} > 0))
                    )
                    or
                    (
                      count by(node) (
                        max by(node, condition) (
                          kube_node_status_condition{condition=~"${npd_nvidia_conditions}"}
                          and on(node)
                          (kube_node_status_capacity{resource="nvidia_com_gpu"} > 0)
                        )
                      )
                      or
                      (0 * max by(node) (kube_node_status_capacity{resource="nvidia_com_gpu"} > 0))
                    )
                  ),
                  "hostname", "$1", "node", "(.*)"
                )
              )
          - record: node_npd_expected_condition_count
            expr: |
              max by(hostname) (
                label_replace(
                  (
                    (0 * max by(node) (kube_node_status_capacity{resource="amd_com_gpu"} > 0) + ${npd_amd_condition_count})
                    or
                    (0 * max by(node) (kube_node_status_capacity{resource="nvidia_com_gpu"} > 0) + ${npd_nvidia_condition_count})
                  ),
                  "hostname", "$1", "node", "(.*)"
                )
              )
          - record: node_npd_unknown
            expr: clamp_max(node_npd_unknown_condition + (node_npd_condition_count < bool node_npd_expected_condition_count), 1)
%{ endif }
%{ if gpu_health_monitoring }
          # Match the managed nodes selected by the add-on configs, even before assignment.
          - record: node_gpu_health_expected
            expr: |
              max by(hostname) (
                label_replace(
                  kube_node_labels{label_node_kubernetes_io_instance_type=~"${gpu_health_monitoring_shape_regex}",label_oci_oraclecloud_com_node_info_managed="true"},
                  "hostname", "$1", "node", "(.*)"
                )
              )
          - record: node_gpu_health_unconfigured
            expr: |
              node_gpu_health_expected
              unless on(hostname)
              max by(hostname) (
                label_replace(
                  kube_node_status_condition{condition="oci.oraclecloud.com/GpuHealthMonitoringConfigured",status="true"} == 1,
                  "hostname", "$1", "node", "(.*)"
                )
              )
%{ endif }
          # Missing add-on configuration is unknown for nodes that its configs select.
          - record: node_gpu_health_fault
            expr: |
              max by(hostname) (
                label_replace(
                  kube_node_status_condition{condition="oci.oraclecloud.com/GpuHealthMonitoringFaultDetected",status="true"},
                  "hostname", "$1", "node", "(.*)"
                )
              )
          - record: node_gpu_health_unknown
            expr: |
              max by(hostname) (
                label_replace(
                  kube_node_status_condition{condition="oci.oraclecloud.com/GpuHealthMonitoringUnavailable",status="true"}
                  or
                  kube_node_status_condition{condition="oci.oraclecloud.com/GpuHealthMonitoringConfigured",status=~"false|unknown"},
                  "hostname", "$1", "node", "(.*)"
                )
%{ if gpu_health_monitoring }
                or node_gpu_health_unconfigured
%{ endif }
              )
          # Active FMS faults from the add-on (hpcFault signals). A signal stays after its fault clears, and lastObservedAt refreshes about every 3 minutes while the fault is active.
          - record: node_gpu_health_hpc_fault
            expr: |
              max by(hostname) (
                label_replace(
                  oke_node_health_report_signal_last_observed_timestamp_seconds{source="hpcFault"} > bool (time() - 900),
                  "hostname", "$1", "node", "(.*)"
                )
              )
          # Baseline for GPU nodes. Expected add-on nodes without configuration are marked unknown above.
          - record: node_gpu_node
            expr: |
              max by(hostname) (
                label_replace(
                  0 * (kube_node_status_capacity{resource=~"(amd|nvidia)_com_gpu"} > 0),
                  "hostname", "$1", "node", "(.*)"
                )
%{ if gpu_health_monitoring }
                or 0 * node_gpu_health_expected
%{ endif }
              )
          - record: node_health_status
            expr: |
              (1 - clamp_max((node_npd_failed or node_gpu_node) + (node_gpu_health_fault or node_gpu_node) + (node_gpu_health_hpc_fault or node_gpu_node), 1))
              * (1 + clamp_max((node_npd_unknown or node_gpu_node) + (node_gpu_health_unknown or node_gpu_node), 1))
